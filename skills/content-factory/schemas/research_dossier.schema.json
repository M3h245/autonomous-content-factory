{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cf.research_dossier",
  "type": "object",
  "required": [
    "topic",
    "sources",
    "facts"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string"
          },
          "published": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessed": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "reference",
              "news",
              "opinion",
              "social"
            ]
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source_ids",
          "risk"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 10
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "quote": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "source_id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}