{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cf.ideas",
  "type": "object",
  "required": [
    "ideas"
  ],
  "properties": {
    "ideas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "angle",
          "format",
          "value_add",
          "fact_ids",
          "scores"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "angle": {
            "type": "string",
            "minLength": 10
          },
          "format": {
            "type": "string",
            "enum": [
              "explainer",
              "myth-bust",
              "listicle",
              "story",
              "how-to",
              "comparison",
              "question",
              "news"
            ]
          },
          "pillar": {
            "type": "string"
          },
          "value_add": {
            "type": "string",
            "minLength": 30
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scores": {
            "type": "object",
            "required": [
              "audience_value",
              "curiosity",
              "originality",
              "evidence_strength",
              "visual_potential",
              "brand_safety"
            ],
            "properties": {
              "audience_value": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "curiosity": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "originality": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "evidence_strength": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "visual_potential": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "brand_safety": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        }
      }
    }
  }
}