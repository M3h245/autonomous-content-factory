{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cf.script",
  "type": "object",
  "required": [
    "video_id",
    "language",
    "beats",
    "publish"
  ],
  "properties": {
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "hook_id": {
      "type": "string"
    },
    "beats": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "hook",
              "setup",
              "value",
              "twist",
              "payoff",
              "cta",
              "loop"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "on_screen": {
            "type": "string"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "publish": {
      "type": "object",
      "required": [
        "title_options",
        "description",
        "hashtags"
      ],
      "properties": {
        "title_options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string"
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}