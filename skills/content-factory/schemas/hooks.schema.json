{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cf.hooks",
  "type": "object",
  "required": [
    "video_id",
    "language",
    "candidates"
  ],
  "properties": {
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "spoken",
          "on_screen",
          "visual",
          "archetype"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "spoken": {
            "type": "string",
            "minLength": 1
          },
          "on_screen": {
            "type": "string"
          },
          "visual": {
            "type": "string",
            "minLength": 1
          },
          "archetype": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}