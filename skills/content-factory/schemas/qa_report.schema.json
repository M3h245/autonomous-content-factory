{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cf.qa_report",
  "type": "object",
  "required": [
    "video_id",
    "status",
    "checks"
  ],
  "properties": {
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "passed_with_warnings",
        "failed",
        "pending_review"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "passed",
          "severity"
        ]
      }
    }
  }
}