{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cf.brief",
  "type": "object",
  "required": [
    "run_id",
    "topic",
    "count",
    "languages",
    "platforms"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "duration_s": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "target": {
          "type": "number"
        }
      }
    },
    "audience": {
      "type": "string"
    },
    "tone": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}