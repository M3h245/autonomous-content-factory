# Copy to .env next to run_factory.* and NEVER commit it. doctor.py reports only whether each name is set.
ANTHROPIC_API_KEY=
# optional services (each unlocks one adapter; leave empty to stay on free local backends)
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_SECRETS=
# local services and paths
CF_FORGE_URL=http://127.0.0.1:7860
CF_RUNS_DIR=D:\shorts-ai\factory\runs
# content memory (default: CF_RUNS_DIR\factory.db); keep it on persistent storage
CF_DB=
