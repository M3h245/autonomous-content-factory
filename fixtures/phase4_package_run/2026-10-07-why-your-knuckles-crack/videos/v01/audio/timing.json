  "sentences": [
    {
      "i": 0,
      "text": "What actually pops when you crack your knuckles?",
      "beat_id": "b1",
      "start": 0.08,
      "end": 2.459
    },
    {
      "i": 1,
      "text": "Not your bones.",
      "beat_id": "b2",
      "start": 2.699,
      "end": 3.869
    },
    {
      "i": 2,
      "text": "Your joints sit in a capsule of fluid.",
      "beat_id": "b2",
      "start": 4.029,
      "end": 6.2
    },
    {
      "i": 3,
      "text": "Pull the joint apart, the pressure drops, and a gas cavity snaps open.",
      "beat_id": "b3",
      "start": 6.44,
      "end": 10.817
    },
    {
      "i": 4,
      "text": "In 2015, scientists filmed it inside an MRI.",
      "beat_id": "b4",
      "start": 11.057,
      "end": 15.407
    },
    {
      "i": 5,
      "text": "The pop happened as the bubble formed.",
      "beat_id": "b4",
      "start": 15.567,
      "end": 17.811
    },
    {
      "i": 6,
      "text": "A 2018 model says a partial collapse could still make the sound.",
      "beat_id": "b5",
      "start": 18.051,
      "end": 22.655
    },
    {
      "i": 7,
      "text": "The debate isn't over.",
      "beat_id": "b5",
      "start": 22.815,
      "end": 24.124
    },
    {
      "i": 8,
      "text": "And arthritis?",
      "beat_id": "b6",
      "start": 24.524,
      "end": 25.605,
      "pause_before": 0.4
    },
    {
      "i": 9,
      "text": "A study of 215 people found no link.",
      "beat_id": "b6",
      "start": 25.765,
      "end": 29.097
    },
    {
      "i": 10,
      "text": "So it's just a bubble.",
      "beat_id": "b7",
      "start": 29.337,
      "end": 30.654
    },
    {
      "i": 11,
      "text": "Do you crack yours?",
      "beat_id": "b7",
      "start": 30.814,
      "end": 32.021
    }
  ]
